# Copie este arquivo para .env.local e preencha os valores.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
# Usada apenas no servidor, pela rotina diária de avisos. NUNCA expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Rotina de avisos: proteja a rota com um segredo qualquer (ex.: gere com `openssl rand -hex 24`)
CRON_SECRET=troque-por-um-segredo-longo

# E-mail de avisos (https://resend.com) - opcional
RESEND_API_KEY=
EMAIL_FROM=App Financeiro <onboarding@resend.dev>

# Notificações push no celular - opcional. Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seuemail@exemplo.com

# Endereço público do app (usado nos links dos e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
